# Attest Framework — Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# Full reference: docs/guides/configuration.md. Check the result with `attest-engine doctor`.

# ── LLM Judge (Layer 6) ──
# Provider: "openai" (default; also OpenAI-compatible endpoints), "anthropic" or "gemini".
ATTEST_JUDGE_PROVIDER=
# Judge key: ATTEST_JUDGE_API_KEY takes precedence over the provider's standard variable
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY / GOOGLE_API_KEY).
# With ATTEST_JUDGE_BASE_URL set, ATTEST_JUDGE_API_KEY is required; standard keys are never sent there.
ATTEST_JUDGE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Provider API root, e.g. http://localhost:11434/v1 for an OpenAI-compatible server.
ATTEST_JUDGE_BASE_URL=
# Judge model (openai default: gpt-4.1; required for anthropic and gemini).
ATTEST_JUDGE_MODEL=
# Judge timeout in seconds (default: 30).
ATTEST_JUDGE_TIMEOUT_S=30
# Judge rate limiting per provider (defaults: 60 requests/min, burst 10).
# ATTEST_RATE_LIMIT_OPENAI=60
# ATTEST_RATE_LIMIT_OPENAI_BURST=10
# ATTEST_RATE_LIMIT_ANTHROPIC=60
# ATTEST_RATE_LIMIT_ANTHROPIC_BURST=10
# ATTEST_RATE_LIMIT_GEMINI=60
# ATTEST_RATE_LIMIT_GEMINI_BURST=10

# ── Embedding (Layer 5) ──
# "auto" (OpenAI if OPENAI_API_KEY is set, else ONNX in onnx builds), "openai", or "onnx"
ATTEST_EMBEDDING_PROVIDER=auto

# ── ONNX Local Embedding (optional, requires onnx build tag) ──
# Default: ~/.attest/models. Use an absolute path; dotenv files do not expand ~.
# ATTEST_ONNX_MODEL_DIR=/home/you/.attest/models
# Path to the ONNX Runtime 1.26 shared library (default: model dir, then system paths).
# ATTEST_ONNX_RUNTIME_LIB=

# ── Evaluation ──
# Maximum soft failures allowed in one engine session (unset: no limit).
# ATTEST_MAX_SOFT_FAILURES=
# Set to 1 to run Layers 5-6 as not_evaluated(simulation) without provider calls.
# ATTEST_SIMULATION=

# ── Cache ──
# Default: ~/.attest/cache. Use an absolute path; dotenv files do not expand ~.
# ATTEST_CACHE_DIR=/home/you/.attest/cache
ATTEST_EMBEDDING_CACHE_MAX_MB=500

# ── Engine Binary ──
# Override path to attest-engine binary (skips all discovery).
ATTEST_ENGINE_PATH=
# Set to 1 to disable auto-download of the engine binary.
# When disabled, you must build from source or download manually.
# ATTEST_ENGINE_NO_DOWNLOAD=
