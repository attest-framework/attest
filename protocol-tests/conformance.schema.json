{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/attest-framework/attest/protocol-tests/conformance.schema.json",
  "title": "Attest Protocol Conformance Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "lines", "expectedDiagnostics", "expectedDesync"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "lines": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prePending": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "default": []
    },
    "expectedDiagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "malformed_json",
              "non_object_response",
              "invalid_jsonrpc_version",
              "missing_id",
              "unknown_id",
              "non_routable_error"
            ]
          },
          "messageContains": { "type": "string" }
        }
      }
    },
    "expectedDesync": { "type": "boolean" }
  }
}
