{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attest-framework.github.io/schemas/v1/cli/trace-check.schema.json",
  "title": "attest-engine trace check --json",
  "description": "Structural integrity and evidence coverage of one trace. ok is false when any issue has severity error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "schema_version",
    "spans",
    "steps",
    "turns",
    "handoffs",
    "retries",
    "ok",
    "issues",
    "coverage"
  ],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "spans": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "turns": {
      "type": "integer",
      "minimum": 0
    },
    "handoffs": {
      "type": "integer",
      "minimum": 0
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    },
    "ok": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "span_id": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "attributes",
          "span_kind",
          "missing",
          "total",
          "span_ids"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "span_kind": {
            "type": "string",
            "minLength": 1
          },
          "missing": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "span_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
