{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attest-framework.github.io/schemas/v1/cli/select.schema.json",
  "title": "attest-engine select --json",
  "description": "The tests a change needs: mode all runs everything (tests is empty), subset runs tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "tests",
    "reasons"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "all",
        "subset"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "class"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "enum": [
              "test",
              "fixture",
              "ignored",
              "all",
              "unknown"
            ]
          }
        }
      }
    }
  }
}
