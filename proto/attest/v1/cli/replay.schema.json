{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attest-framework.github.io/schemas/v1/cli/replay.schema.json",
  "title": "attest-engine replay --json -- <command>",
  "description": "The command's exit code and what the replay served. --json is refused with --serve.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_code",
    "summary",
    "world"
  ],
  "properties": {
    "exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "The command's own exit code; null when it did not exit with one (killed by a signal). Not the process exit code of attest-engine."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture",
        "mode",
        "replayed",
        "live",
        "misses",
        "unused",
        "live_cost_usd",
        "unpriced_live_calls",
        "records"
      ],
      "properties": {
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "strict",
            "auto"
          ]
        },
        "replayed": {
          "type": "integer",
          "minimum": 0
        },
        "live": {
          "type": "integer",
          "minimum": 0
        },
        "misses": {
          "type": "integer",
          "minimum": 0
        },
        "unused": {
          "type": "integer",
          "minimum": 0
        },
        "live_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "unpriced_live_calls": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "provider",
              "api",
              "outcome"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "api": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "replayed",
                  "live",
                  "miss"
                ]
              },
              "exchange": {
                "type": "integer",
                "minimum": 0
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "world": {
      "type": [
        "object",
        "null"
      ],
      "description": "The world's final world-v1 snapshot with --world; null without.",
      "required": [
        "world_version",
        "definition_sha256",
        "state",
        "faults_fired",
        "faults_fired_count"
      ],
      "properties": {
        "world_version": {
          "type": "integer",
          "const": 1
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "type": "object"
        },
        "faults_fired": {
          "type": "array"
        },
        "faults_fired_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
