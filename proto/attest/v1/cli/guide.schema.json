{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attest-framework.github.io/schemas/v1/cli/guide.schema.json",
  "title": "attest-engine guide --json",
  "description": "Without a topic: every embedded guide. With a topic: that guide's Markdown, byte-exact.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics"],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "title"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "title", "markdown"],
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
